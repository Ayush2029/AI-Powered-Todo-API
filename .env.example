# Copy this to .env for local development. Never commit .env to git.
#
# On Render, DATABASE_URL is injected automatically from the linked Postgres
# instance. GROQ_API_KEY is set manually in the Render dashboard.

# Local PostgreSQL via Docker:
#   docker run -d -p 5432:5432 -e POSTGRES_DB=todos_db \
#              -e POSTGRES_USER=todos_user -e POSTGRES_PASSWORD=secret postgres:16
DATABASE_URL=postgresql://todos_user:secret@localhost:5432/todos_db

# FREE Groq API key — no credit card needed
# Get yours at https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_...

# Model (Llama 3.3 70B — fast, free, capable)
GROQ_MODEL=llama-3.3-70b-versatile
